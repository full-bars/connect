# STAGE 1: Build the patched binary
FROM golang:1.22-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make gcc musl-dev

# Set working directory
WORKDIR /src
COPY . .

# Build the community-provider binary from the root level provider directory
WORKDIR /src/provider
RUN go build -o /app/community-provider .

# STAGE 2: Create the runner image (Alpine)
FROM alpine:latest

# Install runtime dependencies
RUN apk add --no-cache \
    curl \
    bash \
    ca-certificates \
    tzdata \
    jq

WORKDIR /app

# Copy the binary we built in Stage 1
COPY --from=builder /app/community-provider /app/community-provider

# Create the JWT-compatible entrypoint
RUN echo '#!/bin/bash' > /app/entrypoint.sh && \
    echo 'echo "Starting Patched UrNetwork Provider (JWT Mode)..."' >> /app/entrypoint.sh && \
    echo 'chmod +x /app/community-provider' >> /app/entrypoint.sh && \
    echo '/app/community-provider "$@"' >> /app/entrypoint.sh && \
    chmod +x /app/entrypoint.sh

ENTRYPOINT ["/bin/bash", "/app/entrypoint.sh"]
