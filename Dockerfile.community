# STAGE 1: Build the patched binary
FROM golang:1.25-alpine AS builder
RUN apk add --no-cache git make gcc musl-dev
WORKDIR /src
COPY . .
RUN go mod edit -dropreplace github.com/urnetwork/glog && \
    sed -i 's|github.com/urnetwork/glog v0.0.0|github.com/urnetwork/glog v0.0.0-20260227220536-1de77fab89bd|g' go.mod && \
    go mod tidy
RUN env GOEXPERIMENT=greenteagc CGO_ENABLED=0 GOOS=linux go build -trimpath -o /app/community-provider ./provider

# STAGE 2: Create the runner image (Alpine)
FROM alpine:latest
RUN apk add --no-cache curl bash ca-certificates tzdata jq
WORKDIR /app
COPY --from=builder /app/community-provider /app/community-provider

# Create the proxy-aware entrypoint
RUN echo '#!/bin/bash' > /app/entrypoint.sh && \
    echo 'echo "Starting Patched UrNetwork Provider..." ' >> /app/entrypoint.sh && \
    echo 'chmod +x /app/community-provider' >> /app/entrypoint.sh && \
    echo '# Ensure the config directory exists' >> /app/entrypoint.sh && \
    echo 'mkdir -p /root/.urnetwork' >> /app/entrypoint.sh && \
    echo '# Initialize proxy config with empty JSON object to avoid panics' >> /app/entrypoint.sh && \
    echo 'echo "{}" > /root/.urnetwork/proxy' >> /app/entrypoint.sh && \
    echo 'sync' >> /app/entrypoint.sh && \
    echo '# If proxy.txt exists, add the proxies first with -f to skip prompts' >> /app/entrypoint.sh && \
    echo 'if [ -f "/app/proxy.txt" ]; then' >> /app/entrypoint.sh && \
    echo '  echo "Loading proxies from proxy.txt..."' >> /app/entrypoint.sh && \
    echo '  /app/community-provider proxy add --proxy_file=/app/proxy.txt -f' >> /app/entrypoint.sh && \
    echo 'fi' >> /app/entrypoint.sh && \
    echo 'echo "Starting Provider Service..."' >> /app/entrypoint.sh && \
    echo '# Check if the first argument is a command, if so add -f' >> /app/entrypoint.sh && \
    echo 'if [[ "$1" == "auth-provide" ]]; then' >> /app/entrypoint.sh && \
    echo '  exec /app/community-provider auth-provide "${@:2}" -f' >> /app/entrypoint.sh && \
    echo 'else' >> /app/entrypoint.sh && \
    echo '  exec /app/community-provider "$@"' >> /app/entrypoint.sh && \
    echo 'fi' >> /app/entrypoint.sh && \
    chmod +x /app/entrypoint.sh

ENTRYPOINT ["/bin/bash", "/app/entrypoint.sh"]
