# STAGE 1: Build the patched binary
FROM golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make gcc musl-dev

# Set working directory to root
WORKDIR /src
COPY . .

# Force fix the go.mod file:
# 1. Remove the local replacement
# 2. Change the v0.0.0 version to a valid commit hash
RUN go mod edit -dropreplace github.com/urnetwork/glog && \
    sed -i 's|github.com/urnetwork/glog v0.0.0|github.com/urnetwork/glog v0.0.0-20240313175133-1de77fab89bd|g' go.mod && \
    go mod tidy

# Build from root using standard Go settings
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /app/community-provider ./provider

# STAGE 2: Create the runner image (Alpine)
FROM alpine:latest

# Install runtime dependencies
RUN apk add --no-cache \
    curl \
    bash \
    ca-certificates \
    tzdata \
    jq

WORKDIR /app

# Copy the binary we built in Stage 1
COPY --from=builder /app/community-provider /app/community-provider

# Create the JWT-compatible entrypoint
RUN echo '#!/bin/bash' > /app/entrypoint.sh && \
    echo 'echo "Starting Patched UrNetwork Provider (JWT Mode)..."' >> /app/entrypoint.sh && \
    echo 'chmod +x /app/community-provider' >> /app/entrypoint.sh && \
    echo '/app/community-provider "$@"' >> /app/entrypoint.sh && \
    chmod +x /app/entrypoint.sh

ENTRYPOINT ["/bin/bash", "/app/entrypoint.sh"]
